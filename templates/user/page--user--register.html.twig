{#
/**
 * @file
 * Template for the main page.
 */
#}

{% if page.outer_sidebar_left %}
  <aside id="outer_sidebar_left" class="bg-white shadow-lg">
    <div class="outer__sidebar__left">
      {{ page.outer_sidebar_left }}
    </div>
  </aside>
{% endif %}

<div class="page flex-fill">


  {% embed '@radix/navbar/navbar.twig' with {
    placement: 'sticky-top',
    container: 'fluid',
    color: 'light',
    utility_classes: ['bg-white border-bottom main___nav'],
  } %}

    {% block branding %}
      {% if page.navbar_branding %}
        {{ page.navbar_branding }}
      {% endif %}
    {% endblock %}

    {% block left %}
      {% if page.navbar_left %}
        <div class="mr-auto">
          {{ page.navbar_left }}
        </div>
      {% endif %}
    {% endblock %}

    {% block right %}
      {% if page.navbar_right %}
        {{ page.navbar_right }}
      {% endif %}
    {% endblock %}
  {% endembed %}

  <div id="_wrapper" class="d-flex">
    <main id="main-content" class="order-1 flex-fill px-md-1 px-sm-0 pb-5 pt-3">
      {% if page.header %}
        <header class="page__header mb-3">
          <div class="container">
            {{ page.header }}
          </div>
        </header>
      {% endif %}

      {% if page.content %}
        <div class="page__content user-forms user-signup">
          <div class="container">
            <h1>Sign up</h1>
            <div class="mb-4 pb-4">
              <p class="lead">Register using your Institution-provided Google or Microsoft account.</p>
              <button class="gsi-material-button" onclick="location.href='/user/login/google';">
                <div class="gsi-material-button-state"></div>
                <div class="gsi-material-button-content-wrapper">
                  <div class="gsi-material-button-icon">
                    <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;">
                      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
                      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
                      <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
                      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
                      <path fill="none" d="M0 0h48v48H0z"></path>
                    </svg>
                  </div>
                  <span class="gsi-material-button-contents">Sign up with Google</span>
                  <span style="display: none;">Sign up with Google</span>
                </div>
              </button>
            </div>

            <hr data-content="OR" class="hr-text">

            <div class="mt-4 pt-4">
              <h2 class="text-muted h4 mb-4">Sign up with email</h2>
              {{ page.content }}
            </div>
          </div>
        </div>
        <div class="small text-center mt-4">
          <p>Have an account? <a href="/login">Log in</a></p>
          <p><a href="/login/forgot-password">Forgot your password?</a></p>
          <p>Question? <a href="mailto:help@camerisefsl.ca">help@camerisefsl.ca</a></p>
        </div>
      {% endif %}
    </main>

    {% if page.sidebar_left %}
      <aside id="sidebar_left" class="order-0 py-sm-1 py-lg-4 shadow-lg" data-simplebar>
        <div class="sidebar__left">
        <div class="d-sm-block d-lg-none py-1 text-align-center">
            <a class="btn btn-light btn-sm rounded-pill d-inline-flex justify-content-center align-items-center" id="toggle-filters-mobile"><span class="material-icons">close</span> Close Filters</a>
        </div>
          {{ page.sidebar_left }}
        </div>
      </aside>
    {% endif %}

  {% if page.sidebar_right %}
    <aside id="sidebar_right" class="order-2">
      <div class="sidebar__right px-3">
        {{ page.sidebar_right }}
      </div>
    </aside>
  {% endif %}
</div>

  {% if page.footer %}
    <footer class="page__footer">
      <div class="">
        <div class="justify-content-md-between align-items-md-center text-center text-md-left border-top bg-white pt-5">
          {{ page.footer }}
        </div>
      </div>
    </footer>
  {% endif %}
</div>
